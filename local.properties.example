# 复制到项目根目录 local.properties（该文件已在 .gitignore 中，不会提交）
# Android SDK 路径由 Android Studio 自动维护，请勿删除 sdk.dir
sdk.dir=C:/path/to/Android/Sdk

# HTTP API（当前阿里云 ECS）
api.base.url=https://47.103.157.213/api
app.update.channel=test

# App 发布签名配置；密码仅保存到忽略目录 .local-tools/signing/release-signing-secrets.env
android.keystore.file=.local-tools/signing/robot-release.jks
android.key.alias=robot-app

# MQTT Broker（与 cloud_comm、EMQX 一致）
mqtt.host=47.103.157.213
mqtt.port=1883
mqtt.username=app_user_001
# 不要提交真实密码；从私下保存的联调信息中复制到本机 local.properties
mqtt.password=

# 联调默认设备标识（设备列表未选时 fallback，正式流程从 HTTP 设备列表选择）
mqtt.product_type=crawler
mqtt.default_device_id=crawler_00000001

# App 测试登录账号（仅本地开发/交接记录，不会编译进 APK）
app.login.email=
app.login.password=
